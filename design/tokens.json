{
  "$schema": "DropBridge design tokens v3 (satu sumber untuk Web/style.css dan Android Ui.kt)",
  "name": "DropBridge 3",
  "font": {
    "ui": "Plus Jakarta Sans",
    "code": "IBM Plex Mono",
    "note": "Keduanya lisensi OFL. 'code' dipakai untuk nomor kontainer/dokumen supaya angka dan huruf mudah dibedakan (0/O, 1/I)."
  },
  "type": {
    "caption":  {"size": 12, "line": 16, "weight": 600},
    "small":    {"size": 14, "line": 20, "weight": 500},
    "body":     {"size": 16, "line": 24, "weight": 500},
    "label":    {"size": 16, "line": 20, "weight": 700},
    "title-sm": {"size": 18, "line": 24, "weight": 700},
    "title":    {"size": 22, "line": 28, "weight": 800},
    "display":  {"size": 28, "line": 34, "weight": 800},
    "code":     {"size": 17, "line": 22, "weight": 600}
  },
  "space": {"1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40},
  "radius": {"sm": 8, "md": 12, "lg": 18, "xl": 24, "pill": 999},
  "size": {"touch": 48, "touch-lg": 56, "icon": 22, "header": 64, "nav": 72, "content-max": 1120, "split": 720},
  "motion": {"fast": "120ms ease-out", "base": "200ms ease-out", "sheet": "260ms cubic-bezier(.2,.8,.2,1)", "reduce": "matikan gerak bila prefers-reduced-motion"},
  "color": {
    "light": {
      "bg": "#F3F6F5", "surface": "#FFFFFF", "surface-2": "#EAF0EE",
      "border": "#D6E0DD", "border-input": "#7E918C",
      "text": "#0E1A18", "text-muted": "#4D5E5A",
      "accent": "#0F766E", "on-accent": "#FFFFFF", "accent-soft": "#DCEFEB", "on-accent-soft": "#0A4A44",
      "guest": "#4F46E5", "on-guest": "#FFFFFF", "guest-soft": "#E6E5FC", "on-guest-soft": "#2E2A8C",
      "success": "#15803D", "warning": "#9A4A07", "warning-soft": "#FFF0D9", "danger": "#B42318", "danger-soft": "#FDE8E6",
      "scrim": "rgba(14,26,24,.48)",
      "shadow-sm": "0 1px 2px rgba(14,26,24,.06)", "shadow-md": "0 10px 28px rgba(14,26,24,.12)"
    },
    "dark": {
      "bg": "#0B1513", "surface": "#13201E", "surface-2": "#1B2B28",
      "border": "#263A36", "border-input": "#6A827D",
      "text": "#E8F1EF", "text-muted": "#A3B6B2",
      "accent": "#3DD6C1", "on-accent": "#042420", "accent-soft": "#123A35", "on-accent-soft": "#BDF3EA",
      "guest": "#A5B4FC", "on-guest": "#13154A", "guest-soft": "#25285A", "on-guest-soft": "#DDE1FF",
      "success": "#4ADE80", "warning": "#FBBF24", "warning-soft": "#3A2A0A", "danger": "#F87171", "danger-soft": "#3A1614",
      "scrim": "rgba(0,0,0,.6)",
      "shadow-sm": "none", "shadow-md": "0 10px 28px rgba(0,0,0,.45)"
    }
  },
  "kind": {
    "light": {"image": "#6D28D9", "video": "#BE185D", "audio": "#C2410C", "doc": "#1D4ED8", "archive": "#854D0E", "other": "#475569"},
    "dark":  {"image": "#C4B5FD", "video": "#F9A8D4", "audio": "#FDBA74", "doc": "#93C5FD", "archive": "#FDE047", "other": "#CBD5E1"}
  }
}
